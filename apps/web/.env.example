# better-auth
# 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth
# Discord Dev Portal → OAuth2 → Redirects:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# App URL (클라이언트 사이드 노출)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://idle:idle@localhost:5433/idle-factory-dev?schema=public

# DB 풀 (서버리스 Function Duration 절감용, 전부 선택 사항)
# Vercel에서는 인스턴스마다 풀이 생기므로 DB_POOL_MAX=1 권장 (기본값: Vercel 1, 상시 프로세스 5).
# 타임아웃 단위는 ms. 상한을 넘기면 빨리 실패해 함수가 오래 열려 있지 않게 한다.
# DB_POOL_MAX=1
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=10000
