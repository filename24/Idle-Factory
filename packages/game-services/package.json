  "dependencies": {
    "@idle/database": "workspace:^",
    "@idle/game-core": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint-config-idle": "workspace:^",
    "tsconfig": "workspace:^",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "private": true
