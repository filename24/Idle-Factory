// Idle Factory — Prisma Schema
// 설계 근거: docs/design/01~11
// 파생값(창고 용량, 등급 배율, 세율 등)은 저장하지 않고 등급·자산에서 계산한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

/// 공장 타입 (docs/03-factories.md)
enum FactoryType {
  // T1 원자재
  FARM // 🌾 농장
  MINE // ⛏️ 광산
  LUMBER // 🌲 목재소
  OIL_WELL // 🛢️ 유전
  // T2 가공
  STEEL_MILL // 🏭 제철소
  REFINERY // ⚗️ 정유소
  FLOUR_MILL // 🍞 제분소
  FURNITURE_FACTORY // 🪑 가구공장
  // T3 완제품 (2×2)
  CAR_FACTORY // 🚗 자동차 공장
  ELECTRONICS_FACTORY // 📱 전자제품 공장
  FOOD_FACTORY // 🍱 식품 공장
}

enum FactoryTier {
  T1
  T2
  T3
}

/// 자재 + 원자재 부스터 (docs/03, 04)
enum MaterialType {
  // T1
  GRAIN // 곡물
  ORE // 광석
  WOOD // 목재
  CRUDE_OIL // 원유
  // T2
  STEEL // 철강
  FUEL // 연료
  PLASTIC // 플라스틱
  PROCESSED_FOOD // 가공식품
  FURNITURE // 가구
  // T3
  CAR // 자동차
  ELECTRONIC // 전자기기
  FINISHED_FOOD // 완제품 식품
  // 특수 — T3 저확률 드롭, Lv50+ 공장에 영구 투입
  RAW_BOOSTER
}

/// 토지 슬롯 종류 (docs/11-land.md)
enum SlotType {
  NORMAL
  ORE // 🪨 광맥 — 광산 +20%
  FERTILE // 🌱 비옥한 땅 — 농장 +20%
  FOREST // 🌳 숲 — 목재소 +20%
  OIL // 🛢️ 유전지 — 유전 +30%
  WATER // 💧 수로 — 인접 농장·제분소 +10%
}

/// 업그레이드 부스터 — 3·5·7·10등급 도달 시 선택, 영구 (docs/03)
enum UpgradeBooster {
  SAVING // 🔻 소비 자재 -20%
  RARE // 🔺 희귀 자재 드롭 +1%
  SPEED // ⚡ tick 생산량 +15%
  PROFIT // 💰 공장 수익 +10%
}

/// 자재 부족 시 동작 모드 (docs/03 — A/B/C → 의미로 변환)
enum ShortageMode {
  PAUSE // A: 생산 중단 (기본)
  AUTO_BUY // B: 마켓 자동 구매
  PARTIAL // C: 비례 생산
}

/// 유저 상점 등록 상태 (docs/06)
enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELED
}

/// 주식 시장 구분 (docs/08)
enum StockMarket {
  SERVER // 서버 내 주식 (Lv10+)
  GLOBAL // 글로벌 주식 (Lv40+, 신뢰도 1500+)
}

/// 거래 로그 종류 — 사기 방지 + XP 중복 방지
enum TradeKind {
  MARKET_SELL // 글로벌/유저 상점 판매
  USER_TRADE // 유저 직거래
  DIRECT_BUY // 자재 직구매 (×2 할증)
  STOCK_BUY
  STOCK_SELL
  DIVIDEND
}

/// 퀘스트 종류 — 도메인별 만료/리셋/시퀀싱 정책 분기점.
/// (docs/design/00-onboarding.md §튜토리얼 퀘스트 체인)
enum QuestKind {
  TUTORIAL // 순차 체인, 1회성, 영구 보존
  DAILY // UTC 자정 리셋 — 인프라 자리만 (미사용)
  ACHIEVEMENT // 1회성, 영구 보존, 누적형
  EVENT // 기간 한정 — 인프라 자리만 (미사용)
}

/// UserQuest 라이프사이클. IN_PROGRESS → COMPLETED → CLAIMED.
enum QuestStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

// ──────────────────────────────────────────────────────────────
// 유저 / 서버
// ──────────────────────────────────────────────────────────────

/// Discord 유저. id 는 Discord snowflake.
model User {
  id                   String    @id
  nickname             String?
  lang                 String    @default("ko")
  money                BigInt    @default(0) // 💰 지갑
  xp                   BigInt    @default(0)
  level                Int       @default(1)
  flag                 BigInt    @default(1) // 비트 플래그
  lastActiveAt         DateTime  @default(now())
  // ⚠️ deprecated (#16): 자재 직구매 일일 한도의 단일 진실 소스는 DailyPurchase
  // 테이블이다. 아래 두 캐시 컬럼은 사용하지 않는다 — additive-only 원칙에 따라
  // 컬럼 삭제 없이 방치한다. 신규 코드에서 읽기/쓰기 금지.
  dailyBought          Int       @default(0)
  dailyBoughtResetAt   DateTime  @default(now())
  createdAt            DateTime  @default(now())
  // 약관·개인정보 동의 감사 (docs/design/00-onboarding.md §온보딩 동의)
  // 두 컬럼이 모두 not-null 인 유저만 게임 명령을 사용할 수 있다.
  agreedTermsAt        DateTime?
  agreedPrivacyAt      DateTime?
  agreedTermsVersion   String?
  agreedPrivacyVersion String?

  lands       Land[]
  warehouse   Warehouse?
  factories   Factory[]
  listings    MarketListing[]
  holdings    StockHolding[]
  purchases   DailyPurchase[]
  settlements WeeklySettlement[]
  tradesFrom  TradeLog[]         @relation("TradeFrom")
  tradesTo    TradeLog[]         @relation("TradeTo")
  userQuests  UserQuest[]

  @@index([agreedTermsAt])
}

/// Discord 서버. id 는 snowflake. 퇴장 추적을 위해 leftAt 유지.
model Guild {
  id                String    @id
  name              String
  lang              String    @default("ko")
  credit            Int       @default(1000) // 신뢰도 0~2000 (docs/07)
  vault             BigInt    @default(0) // 서버 금고
  weeklyDAU         Int       @default(0)
  taxSurcharge      Float     @default(0) // 관리자 가산치 0~0.20
  flag              BigInt    @default(1)
  joinedAt          DateTime  @default(now())
  leftAt            DateTime? // 봇 퇴장 시각 — 30일 경과 시 분배 풀로
  announceChannelId String? // 글로벌 이벤트(신뢰도·재분배·긴급지원금) 공지 채널 (docs/07)

  factories       Factory[]
  stocks          Stock[]
  settlements     WeeklySettlement[]
  settlementLines WeeklySettlementLine[] @relation("GuildSettlementLines")
  inactivePool    InactiveServerPool?
  trades          TradeLog[]             @relation("GuildTrades")
}

// ──────────────────────────────────────────────────────────────
// 토지 / 슬롯
// ──────────────────────────────────────────────────────────────

/// 유저당 최대 5개 (docs/11). 기본 4×4 고정. index 1 이 시작 토지.
model Land {
  id     String @id @default(cuid())
  userId String
  index  Int    @default(1) // 1..5, 구매 순서
  width  Int    @default(4)
  height Int    @default(4)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     Slot[]
  factories Factory[]

  @@unique([userId, index])
  @@index([userId])
}

/// 토지 내 개별 슬롯. T3 공장(2×2)은 4개 슬롯이 같은 factoryId 를 공유.
/// `locked=true` 는 아직 구매되지 않은 확장 슬롯 — UI에서 disabled 🟩 버튼으로 렌더됨. (docs/11-land.md §슬롯 확장)
model Slot {
  id        String   @id @default(cuid())
  landId    String
  x         Int
  y         Int
  type      SlotType @default(NORMAL)
  locked    Boolean  @default(false)
  factoryId String? // 비어있으면 null

  land    Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  factory Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull)

  @@unique([landId, x, y])
  @@index([factoryId])
}

// ──────────────────────────────────────────────────────────────
// 공장 / 노동자
// ──────────────────────────────────────────────────────────────

/// 공장. grade 1~10, 생산 배율 = 1.5^(grade-1) (원자재 부스터 적용 시 ×1.2).
/// T3 는 2×2, 그 외 1×1. anchor 는 좌상단 슬롯 좌표.
model Factory {
  id             String          @id @default(cuid())
  userId         String
  landId         String // 소속 토지 (다중 토지 지원 — docs/11-land.md)
  guildId        String? // 소속 서버 (게임 맥락)
  type           FactoryType
  tier           FactoryTier
  grade          Int             @default(1)
  exp            BigInt          @default(0)
  anchorX        Int
  anchorY        Int
  width          Int             @default(1)
  height         Int             @default(1)
  lastHarvestAt  DateTime        @default(now()) // tick 계산 기준 (10분/tick)
  shortageMode   ShortageMode    @default(PAUSE)
  upgradeBooster UpgradeBooster? // 3/5/7/10 등급 선택, 영구
  hasRawBooster  Boolean         @default(false) // 원자재 부스터 적용 (영구, 1회)
  flag           BigInt          @default(1)
  createdAt      DateTime        @default(now())

  owner   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  land    Land     @relation(fields: [landId], references: [id], onDelete: Cascade)
  guild   Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull)
  workers Worker[]
  slots   Slot[]
  stock   Stock?

  @@index([userId])
  @@index([landId])
  @@index([guildId])
}

/// 노동자
model Worker {
  id        String  @id @default(cuid())
  factoryId String?
  name      String
  job       String
  exp       BigInt  @default(0)
  athletics Float   @default(0) // 달리기
  strength  Float   @default(0) // 힘
  machinery Float   @default(0) // 작동
  flag      BigInt  @default(1)

  factory Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull)

  @@index([factoryId])
}

// ──────────────────────────────────────────────────────────────
// 창고 / 자재
// ──────────────────────────────────────────────────────────────

/// 공용 창고 — 유저당 1개, 통합 용량 (docs/05). 용량은 grade 에서 계산.
model Warehouse {
  id     String @id @default(cuid())
  userId String @unique
  grade  Int    @default(1) // 1~10

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stacks WarehouseStack[]
}

/// 창고 내 자재별 보유량. (warehouseId, material) unique.
model WarehouseStack {
  id          String       @id @default(cuid())
  warehouseId String
  material    MaterialType
  count       BigInt       @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, material])
}

// ──────────────────────────────────────────────────────────────
// 마켓
// ──────────────────────────────────────────────────────────────

/// 글로벌 마켓 — 자재별 변동가 (docs/06). 30분 주기 갱신.
/// 유저 직구매가 = currentPrice × 2.
///
/// 가격 tick(30분)마다 `currentPrice` 를 재계산하고 거래량 윈도를 리셋한다
/// (docs/design/06-market.md §가격 산출 공식):
///  - `recentSales`      : 현재 30분 윈도의 누적 거래량. tick 에서 0 으로 리셋.
///  - `avgSales`         : 30분 윈도 거래량의 지수이동평균(EMA).
///    tick 마다 `ema = ema×0.9 + recentSales×0.1` 로 갱신 — 상수 기준선 대신
///    EMA 를 쓰면 유저 규모 변화에 수요 기준선이 자동 적응한다(#15 v1 결정,
///    v2 rolling average 마이그레이션 불필요). avgSales=0 이면 demandFactor=0
///    (0-나눗셈 가드, #15 U-5).
///  - `windowStartedAt`  : 현재 윈도 시작 시각. tick 에서 갱신 — 관측/디버깅용.
model GlobalMarketPrice {
  material        MaterialType @id
  basePrice       BigInt
  currentPrice    BigInt
  recentSales     Int          @default(0) // 최근 30분 거래량 (현재 윈도)
  avgSales        Float        @default(0) // 30분 거래량 EMA (tick 마다 ×0.9 + recent×0.1)
  windowStartedAt DateTime     @default(now()) // 현재 30분 윈도 시작 시각
  updatedAt       DateTime     @updatedAt
}

/// 유저 상점 등록 (docs/06). 세율은 등록 시점 값으로 고정.
model MarketListing {
  id           String        @id @default(cuid())
  sellerId     String
  /// 등록 시점의 활동 서버(snowflake) 캡처 — best-effort, FK 없음.
  /// 만료 회수(expireStale)는 인터랙션이 없어 활동 서버를 알 수 없으므로 이 값을
  /// 회수 TradeLog 의 guildId 대체값으로 쓴다. 서버 탈퇴 후에도 원본을 보존하고,
  /// TradeLog.guildId(FK) 측 가드가 유령 참조를 방어한다.
  /// 근거: docs/design/09-level-xp.md §사기 방지 (거래의 활동 서버 귀속).
  guildId      String?
  material     MaterialType
  price        BigInt // 단가
  qty          Int
  durationDays Int // 1~30
  taxRate      Float // 3% ~ 18% (등록 시점 확정)
  status       ListingStatus @default(ACTIVE)
  registeredAt DateTime      @default(now())
  expiresAt    DateTime

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([material, status])
  @@index([expiresAt])
}

/// 자재 직구매 일일 한도 추적 (docs/04). (userId, date) unique.
/// 일일 한도의 단일 진실 소스 — User.dailyBought 캐시 컬럼은 deprecated (#16).
model DailyPurchase {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // KST(UTC+9) 자정 경계의 UTC 순간 (#16 확정 — U-6 주간 정산 KST 와 일관)
  totalBought Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ──────────────────────────────────────────────────────────────
// 주식
// ──────────────────────────────────────────────────────────────

/// 상장 공장 (docs/08). Factory 와 1:1. SERVER 시장 종목은 guildId 필수.
model Stock {
  id                String      @id @default(cuid())
  factoryId         String      @unique
  market            StockMarket
  guildId           String? // SERVER 시장 종목의 소속 서버
  ipoPrice          BigInt
  currentPrice      BigInt
  sharesOutstanding Int         @default(100)
  lastTickAt        DateTime    @default(now())
  weeklyProfit      BigInt      @default(0) // 배당 산정용 (주 1회 정산으로 리셋)
  listedAt          DateTime    @default(now())

  factory  Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  guild    Guild?           @relation(fields: [guildId], references: [id], onDelete: SetNull)
  holdings StockHolding[]
  ticks    StockPriceTick[]

  @@index([market])
  @@index([guildId])
}

/// 유저의 종목별 보유 주식
model StockHolding {
  id      String @id @default(cuid())
  userId  String
  stockId String
  shares  Int    @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId])
}

/// 주가 히스토리 — 1시간 주기
model StockPriceTick {
  id      String   @id @default(cuid())
  stockId String
  price   BigInt
  tickAt  DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, tickAt])
}

// ──────────────────────────────────────────────────────────────
// 로그 / 정산 / 재분배
// ──────────────────────────────────────────────────────────────

/// 거래 로그 — 사기 방지·XP 중복 방지·통계용.
///
/// v0 마켓 기록 규약 (docs/design/09-level-xp.md §사기 방지):
///  - 실판매(buy): kind=MARKET_SELL, fromUserId=판매자, toUserId=구매자,
///    amount=수량, price=총액(gross).
///  - 취소/만료(cancel·expire): kind=MARKET_SELL 를 유지하되 toUserId=null,
///    price=0 으로 실판매와 구분한다(자재 회수 이벤트 — enum 미확장 v0).
///    amount 에는 회수 수량을 남긴다.
///  - 글로벌 판매(유저→시스템, #15 U-3): kind=MARKET_SELL, fromUserId=판매자,
///    toUserId=null(상대 없음), price=총액(>0). toUserId=null 이면서 price>0 인
///    행이 글로벌 판매 — price=0 인 회수(cancel/expire)와 구분된다.
///    MARKET_SELL enum 주석("글로벌/유저 상점 판매")의 원 의도를 따르는 것으로
///    enum 확장 없이 판별 가능해 v1 은 enum 을 확장하지 않는다.
/// 반복 상대 XP 감쇠는 (fromUserId,toUserId,kind,createdAt) 카운트로 판정하므로
/// toUserId=null 인 회수·글로벌 판매 기록은 감쇠 카운트에 잡히지 않는다.
model TradeLog {
  id         String        @id @default(cuid())
  fromUserId String?
  toUserId   String?
  /// 거래가 발생한 활동 서버(snowflake). buy/cancel 은 인터랙션 guildId,
  /// expire 는 MarketListing.guildId 를 승계. 서버 탈퇴 시 SetNull.
  /// 근거: docs/design/09-level-xp.md §사기 방지 (활동 서버 귀속).
  guildId    String?
  kind       TradeKind
  material   MaterialType?
  amount     BigInt        @default(0)
  price      BigInt        @default(0)
  createdAt  DateTime      @default(now())

  fromUser User?  @relation("TradeFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User?  @relation("TradeTo", fields: [toUserId], references: [id], onDelete: SetNull)
  guild    Guild? @relation("GuildTrades", fields: [guildId], references: [id], onDelete: SetNull)

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([kind, createdAt])
  @@index([guildId, createdAt])
  // 반복 상대 XP 감쇠 카운트 전용 인덱스 — 쿼리 필터(fromUserId·toUserId·kind 동등 +
  // createdAt 범위)와 순서 일치. MARKET_SELL 외 kind 가 적재돼도 유효하다.
  @@index([fromUserId, toUserId, kind, createdAt])
}

/// 주 1회 세금 정산 (docs/07) — 유저×주 단위 헤더 레코드.
/// 정산 시각: 매주 일요일 00:00 KST (cron 은 UTC 토 15:00) — U-6, 2026-07-03 확정.
/// weekStart 는 정산 대상 주의 시작(직전 일요일 00:00 KST 의 UTC 순간).
///
/// (userId, weekStart) unique 가 멱등성 앵커 (#16): 잡이 2회 실행돼도 두 번째
/// 삽입이 P2002 로 실패해 유저 트랜잭션 전체(과세·금고 적립 포함)가 롤백된다.
/// 서버별 과세 내역은 WeeklySettlementLine 자식 행으로 기록한다 (D-1 귀속 모델).
model WeeklySettlement {
  id           String   @id @default(cuid())
  userId       String
  /// ⚠️ deprecated (#16): 서버별 내역이 WeeklySettlementLine 으로 분리되면서
  /// 헤더의 서버 귀속 개념이 사라졌다. 신규 행은 항상 null. additive-only 원칙에
  /// 따라 컬럼은 유지하되 신규 코드에서 사용 금지.
  guildId      String?
  weekStart    DateTime
  /// 주간 판매 수익 합계 (gross, 전 서버 합산 — #16 v1 은 TradeLog.price 합).
  salesRevenue BigInt   @default(0)
  /// 산정된 총 세액 (전 서버 합산).
  taxDue       BigInt   @default(0)
  /// 실제 납부된 세액 — 현금 부족 시 taxDue 보다 작을 수 있다 (미납 가드, #16).
  taxPaid      BigInt   @default(0)
  /// 미납 잔액 = taxDue - taxPaid. 신뢰도 패널티 연동은 #17 소관.
  unpaidAmount BigInt   @default(0)
  /// 정산 시점 총자산 평가 스냅샷 (U-2) — 누진 구간 판정 근거 감사용.
  totalAssets  BigInt   @default(0)
  /// 적용된 누진 기본세율 (1만분율 — 500~2000). 서버 가산세는 라인별 기록.
  baseTaxBps   Int      @default(0)
  createdAt    DateTime @default(now())

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild?                 @relation(fields: [guildId], references: [id], onDelete: SetNull)
  lines WeeklySettlementLine[]

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@index([guildId, weekStart])
}

/// 주간 정산의 서버별 과세 내역 한 줄 (#16, D-1 귀속 모델).
/// 세율 = 누진 기본세율(유저 글로벌 자산) + 해당 서버 가산세(cap 40%).
/// guildId=null 라인은 서버 밖(DM 등) 판매분 — 기본 세율로 과세하되 금고 적립 없음.
/// 납부 배분: 현금 부족 시 guildId 오름차순 → null 라인 순서로 결정적 그리디 배분.
model WeeklySettlementLine {
  id           String   @id @default(cuid())
  settlementId String
  /// 판매가 발생한 서버 (TradeLog.guildId 승계). null = 서버 밖 판매분.
  guildId      String?
  /// 부모 헤더의 weekStart 복제 — 서버별 최근 정산 조회(/server vault)용 비정규화.
  weekStart    DateTime
  /// 이 서버에서 발생한 주간 판매 수익 (gross).
  salesRevenue BigInt   @default(0)
  /// 이 서버 몫 세액 (유효 세율 적용).
  taxDue       BigInt   @default(0)
  /// 실제 납부분 — guildId 가 있으면 같은 액수가 Guild.vault 로 적립된다.
  taxPaid      BigInt   @default(0)
  /// 적용된 유효 세율 (1만분율, 누진+가산 cap 40%) — 감사용 스냅샷.
  appliedBps   Int      @default(0)

  settlement WeeklySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  guild      Guild?           @relation("GuildSettlementLines", fields: [guildId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([guildId, weekStart])
}

/// 서버×유저 일간 활동 기록 — Guild.weeklyDAU 집계 원천 (#16, #17 신뢰도 입력).
/// 커맨드 성공(chatInputCommandSuccess) 시 upsert. date 는 KST 자정 경계의 UTC 순간.
/// 주간 정산 잡이 distinct userId 수로 weeklyDAU 를 갱신한 뒤 2주 초과분을 정리한다.
/// FK 없음 — best-effort 기록이 유저/길드 행 시드 여부·삭제에 좌우되지 않도록.
model GuildDailyActivity {
  id      String   @id @default(cuid())
  guildId String
  userId  String
  date    DateTime

  @@unique([guildId, userId, date])
  @@index([guildId, date])
  @@index([date])
}

/// 비활성 서버 자산 풀 (docs/07).
/// 봇 퇴장 후 30일 경과 시 적립, 매월 1일 자정에 활성 서버로 분배.
model InactiveServerPool {
  id            String    @id @default(cuid())
  guildId       String    @unique
  frozenAmount  BigInt    @default(0)
  exitedAt      DateTime
  distributedAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────
// 퀘스트
// ──────────────────────────────────────────────────────────────

/// 한 유저의 한 퀘스트 인스턴스. 카탈로그(코드)와 questId 로 결합.
/// target 과 rewardSnapshot 은 시드 시점의 카탈로그를 박아 정의 변경에 면역.
/// (docs/design/00-onboarding.md §튜토리얼 퀘스트 체인)
model UserQuest {
  id             String      @id @default(cuid())
  userId         String
  questId        String // 카탈로그 키 (예: "tutorial.1")
  kind           QuestKind
  status         QuestStatus @default(IN_PROGRESS)
  progress       BigInt      @default(0) // 진행도 (BigInt — 누적형 확장 대비)
  target         BigInt // 카탈로그 정의 스냅샷
  rewardSnapshot Json // Reward[] 스냅샷 — 클레임 결정성 보장
  completedAt    DateTime?
  claimedAt      DateTime?
  expiresAt      DateTime? // EVENT/DAILY 만료 자리 (미사용)
  resetAt        DateTime? // DAILY 다음 리셋 자리 (미사용)
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, status])
  @@index([userId, kind])
  @@index([userId, status, kind])
}

// ──────────────────────────────────────────────────────────────
// 공지
// ──────────────────────────────────────────────────────────────

model Notice {
  id          String   @id @default(uuid())
  title       String
  description String
  postedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([postedAt])
}

// ──────────────────────────────────────────────────────────────
// better-auth 전용 테이블 (웹 인증)
// 게임 User 모델과 이름 충돌을 피하기 위해 Auth* prefix + @@map("auth_*") 사용
// ──────────────────────────────────────────────────────────────

/// better-auth 웹 인증 유저 (게임 User와 별개)
model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_user")
}

/// better-auth 세션
model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

/// better-auth OAuth 계정 연결 (accountId = Discord snowflake)
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("auth_account")
}

/// better-auth 이메일 인증 토큰
model AuthVerification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("auth_verification")
}
