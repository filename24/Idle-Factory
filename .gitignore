# Packages
node_modules/

# Log files
logs/
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Env
# 실제 자격증명이 든 파일은 전부 추적 제외한다. `.env` 하나만 무시하면
# `.env.prod`, `.env.local`, `.env.production` 같은 변형이 그대로 커밋될 수 있다.
# 템플릿(`.env.example`, `.env.prod.example`)만 예외로 되살린다.
.env
.env.*
!.env.example
!.env.*.example

# Dist
dist/

# Coverage reports
coverage/

# Prisma v7 generated client
packages/database/src/generated/

# Miscellaneous
.tmp/
.turbo
.idea/
.DS_Store

# pnpm
.pnp.*.sim-output/

# graphify — 지식 그래프 산출물
# 추적: cache/ast, cache/semantic (콘텐츠 해시 기반, 머신 독립 → 재추출 토큰 절약)
# 무시: 재생성 가능한 산출물 + 머신 종속 상태
graphify-out/cost.json
graphify-out/.graphify_*
graphify-out/graph.json
graphify-out/graph.html
graphify-out/index.html
graphify-out/GRAPH_REPORT.md
graphify-out/GRAPH_TREE.html
graphify-out/memory/
graphify-out/reflections/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/cache/stat-index.json
graphify-out/cache/last_query_stamp
# 매 재빌드마다 갱신돼 작업트리를 더럽히고 브랜치 전환을 막음. 캐시로부터 재생성됨
graphify-out/manifest.json
# 훅이 백그라운드 재빌드 중 생성하는 런타임 상태
graphify-out/.pending_changes
graphify-out/.rebuild.lock