      "rationale": "All conditions ANDed and auto-verified with no admin approval. The listing user picks the final IPO price but is clamped to 30-70% of the computed default, preventing extreme over/under-valuation while preserving player agency."
    },
    {
      "id": "docs_design_08_stock_price_tick_formula",
      "label": "Hourly Stock Price Recalculation",
      "file_type": "concept",
      "source_file": "docs/design/08-stock.md",
      "source_location": "L57-L70",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Price moves on demand pressure and profit delta with a daily +-30% circuit breaker. U-5 guard: totalVolume = 0 forces demandPressure = 0 and avg7dProfit = 0 forces profitDelta = 0. Not yet implemented."
    },
    {
      "id": "docs_design_08_stock_dividend",
      "label": "Weekly Dividend Distribution",
      "file_type": "concept",
      "source_file": "docs/design/08-stock.md",
      "source_location": "L72-L87",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Paid weekly at the same Sunday-midnight moment as tax settlement from 10% of the company's weekly profit. Trading itself is fee-free because inflation control is handled by the progressive asset tax instead."
    }
