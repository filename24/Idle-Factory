# Idle Factory — 프로덕션 환경변수 템플릿
#
# VPS 에서:
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod        # 자격증명 파일이다. 반드시 권한을 좁힐 것.
#   docker compose --env-file .env.prod -f compose.prod.yml up -d
#
# .gitignore 가 `.env.*` 를 무시하고 `.env.*.example` 만 예외로 둔다.
# 실제 값이 든 .env.prod 는 절대 커밋되지 않는다.

# ──────────────────────────────────────────────────────────────
# 어떤 서비스를 이 호스트에서 돌릴지
# ──────────────────────────────────────────────────────────────
# web 컨테이너는 이 프로파일이 켜져 있을 때만 뜬다. 비워 두면 봇·DB·Redis 만
# 돌아가므로, web 을 Vercel 에 올릴 때 이 값을 비운다.
# ⚠️ 이 줄을 지우면 web 이 조용히 사라진다. Vercel 로 옮긴 것이 아니라면
#    반드시 self-hosted 를 유지할 것.
COMPOSE_PROFILES=self-hosted

# ──────────────────────────────────────────────────────────────
# 배포 대상 이미지
# ──────────────────────────────────────────────────────────────
# 배포 워크플로가 푸시하는 불변 태그. 롤백은 이 한 줄을 이전 SHA 로 바꾸고
# `docker compose ... up -d` 를 다시 실행하는 것으로 끝난다.
# 예: sha-a1b2c3d  (`latest` 도 유효하지만 무엇이 돌고 있는지 알 수 없어 비권장)
IMAGE_TAG=latest
# GHCR 경로. 레포 이름이 바뀌지 않으면 그대로 둔다.
IMAGE_REGISTRY=ghcr.io/filename24

# ──────────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────────
POSTGRES_USER=idle
# 반드시 새로 생성할 것: openssl rand -hex 32
#
# ⚠️ base64 로 만들지 말 것. 출력에 `/` 가 섞일 수 있는데, 그 값이 아래
# DATABASE_URL 에 들어가면 `/` 가 URL 의 경로 시작으로 해석돼 포트 파싱이 깨진다.
# Prisma 가 `P1013: invalid port number in database URL` 로 죽는다(실제로 겪음).
# hex 는 0-9a-f 뿐이라 이 문제가 없다.
POSTGRES_PASSWORD=
# ⚠️ 이름이 `-dev` 로 끝나면 안 된다. apps/bot 의 통합 테스트는 DATABASE_URL 이
# `-dev` 로 끝날 때만 동작하며 매 테스트마다 전체 테이블을 TRUNCATE 한다.
# 프로덕션 DB 이름을 `-dev` 로 두면 실수로 실행된 테스트가 데이터를 지운다.
POSTGRES_DB=idle-factory

# 위 세 값과 반드시 일치해야 한다. 호스트명은 compose 서비스명 `postgres` 다
# (localhost 가 아니다 — 컨테이너 안에서 localhost 는 자기 자신이다).
#
# ⚠️ 외부(예: Vercel)에서도 DB 를 쓰더라도 **이 값은 내부 주소로 둔다.**
# 여기에 호스트의 공인 IP 를 넣으면 봇·migrator 컨테이너가 밖으로 나갔다
# 돌아오는 경로를 타야 해서, NAT 헤어핀이 안 되는 호스트에서는 접속에 실패한다.
# 외부용 주소는 그쪽 플랫폼의 환경변수에만 넣는다.
DATABASE_URL=postgresql://idle:CHANGE_ME@postgres:5432/idle-factory?schema=public

# ── DB 포트 노출 (기본: 호스트 안에서만) ──
# compose 내부 통신에는 필요 없다. 외부에서 붙어야 할 때만 넓힌다.
#   DB_BIND=127.0.0.1  호스트 안에서만 (기본, 권장)
#   DB_BIND=0.0.0.0    인터넷에 개방 — 강한 비밀번호와 sslmode=require 필수
DB_BIND=127.0.0.1
DB_PORT=5444

# ──────────────────────────────────────────────────────────────
# Redis (BullMQ 예약 작업 + 캐시)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────────────────────
# Discord 봇
# ──────────────────────────────────────────────────────────────
BOT_TOKEN=
BOT_NAME=Idle Factory
# 쉼표 구분 Discord 유저 ID. /admin·/debug 접근 권한을 가진다.
BOT_OWNERS=
BOT_SHARDING=false
BUILD_VERSION=0.1.4
# 프로덕션에서는 비워 둔다. 값이 있으면 슬래시 명령이 그 길드에만 등록된다.
DEV_GUILD_ID=
LOG_LEVEL=chat
LOG_DEV=false
REPORT_TYPE=webhook
REPORT_WEBHOOK_URL=
# /admin 감사 로그 알림용 채널 웹후크. 비우면 DB 에만 기록한다.
ADMIN_AUDIT_WEBHOOK_URL=
I18N_FALLBACK_LNG=en-US

# ──────────────────────────────────────────────────────────────
# Web (better-auth + Discord OAuth)
# ──────────────────────────────────────────────────────────────
# web 을 Vercel 에서 돌리는 경우(COMPOSE_PROFILES 를 비운 경우)에도 아래 값들은
# 지우지 말 것. compose 는 프로파일로 제외된 서비스의 변수까지 보간하므로 비어
# 있으면 모든 compose 명령이 멈춘다. 대신 web 이 뜨지 않으므로 실제 시크릿을
# 둘 필요는 없다 — 자리만 채우고(예: unused) 진짜 값은 Vercel 환경변수에 넣는다.
# 호스트 리버스 프록시가 이 포트로 붙는다. 127.0.0.1 에만 바인딩된다.
WEB_PORT=3000
# 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# ⚠️ 실제 서비스 도메인으로 바꿀 것. OAuth 콜백 URL 이 이 값으로 조립되므로
# 플레이스홀더를 그대로 두면 로그인이 example.com 으로 리다이렉트된다.
# Discord Dev Portal → OAuth2 → Redirects 에 다음을 등록해야 한다:
#   https://example.com/api/auth/callback/discord
BETTER_AUTH_URL=https://example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NEXT_PUBLIC_APP_URL 은 여기에 없다. Next.js 가 빌드 시점에 클라이언트
# 번들로 치환하므로 런타임 주입이 불가능하다. web 과 다른 오리진에서 인증을
# 붙일 때만 이미지 빌드 인자로 넘긴다(apps/web/Dockerfile 참고).
# 같은 오리진이면 비워 두는 것이 정상이며 상대 경로로 동작한다.

# ──────────────────────────────────────────────────────────────
# 백업 (scripts/db-backup.sh)
# ──────────────────────────────────────────────────────────────
# 로컬 보관 경로와 보관 일수.
BACKUP_DIR=/var/backups/idle-factory
BACKUP_RETENTION_DAYS=7
# Cloudflare R2 오프사이트 업로드. R2_BUCKET 을 비우면 로컬 보관만 한다.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 쪽 보관 일수(로컬보다 길게 잡는다). 실제 만료는 버킷 lifecycle 규칙으로도 걸 수 있다.
R2_RETENTION_DAYS=30
