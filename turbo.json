{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "**/tsconfig.json", "**/tsup.config.ts"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "BOT_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "NEXT_PUBLIC_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**/*.ts"],
      "outputs": ["dist/**", "build/**"],
      "outputLogs": "errors-only"
    },
    "web#build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["public/**", "src/**/*.tsx", "src/**/*.ts", "src/**/*.css", "next.config.js"],
      "outputs": [".next/**", "!.next/cache/**"],
      "outputLogs": "full"
    },
    "lint": {
      "inputs": [
        "**/.eslintignore",
        "**/.eslintrc.json",
        "**/.prettierignore",
        "**/.prettierrc.json",
        "**/tsconfig.eslint.json",
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.css",
        "src/**/*.js",
        "src/**/*.mjs",
        ".prettierrc.js",
        ".prettierrc.cjs",
        "next.config.js"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "format": {
      "inputs": [
        "**/.eslintignore",
        "**/.eslintrc.json",
        "**/.prettierignore",
        "**/.prettierrc.json",
        "**/tsconfig.eslint.json",
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.css",
        "src/**/*.js",
        "src/**/*.mjs",
        ".prettierrc.js",
        ".prettierrc.cjs",
        "next.config.js"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "dev": {
      "dependsOn": ["db:generate", "^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["db:generate", "^build"],
      "cache": true
    },
    "bot#test": {
      "dependsOn": ["db:generate", "^build"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["db:generate", "^build"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["db:generate", "^build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["db:generate", "^build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate:deploy": {},
    "db:push": {},
    "db:seed": {}
  }
}
